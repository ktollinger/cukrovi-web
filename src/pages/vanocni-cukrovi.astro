---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHero from '../components/PageHero.astro';
import OrderCta from '../components/OrderCta.astro';
import PhotoPlaceholder from '../components/ui/PhotoPlaceholder.astro';
import { CHRISTMAS_BOX_PRICES, CHRISTMAS_COOKIES } from '../data/products';
import { withBase } from '../data/site';
---

<Layout
  title="Vánoční cukroví | RAWTÍK – Raw cukroví bez lepku a laktózy"
  description="Ručně vyráběné vánoční raw cukroví slazené datlemi a medem od včelaře. 5 druhů v krabičkách 300 g, 500 g a 1 000 g."
  currentPath="/vanocni-cukrovi"
>
  <section class="pt-6 pb-12 sm:pt-10 sm:pb-16">
    <div class="max-w-5xl mx-auto px-4">
      <Breadcrumbs
        items={[
          { label: 'Domů', href: '/' },
          { label: 'Nabídka a ceník', href: '/#nabidka' },
          { label: 'Vánoční cukroví' },
        ]}
      />

      <PageHero
        title="Vánoční cukroví"
        lead="Vánoční cukroví z kvalitních surovin, slazené datlemi a medem od včelaře. Přirozeně bez lepku a laktózy."
        placeholderLabel="Úvodní foto: vánoční krabička s cukrovím"
        viewTransitionName="cat-vanocni-cukrovi"
      >
        <p class="inline-flex items-baseline gap-2 px-3.5 py-2 rounded-xl bg-surface border border-line text-sm text-ink">
          <span class="font-semibold text-cinnamon">Trvanlivost:</span>
          <span>7 dní v lednici, případně možné zamrazit.</span>
        </p>
      </PageHero>

      <!-- Kompaktní řádek ceníku krabiček -->
      <div class="reveal mt-10 rounded-[var(--radius-card)] bg-surface border border-line p-4 sm:p-5">
        <div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-line text-center">
          {
            CHRISTMAS_BOX_PRICES.map((box) => (
              <div class="py-3 sm:py-1 sm:px-4 flex sm:flex-col items-center justify-between sm:justify-center gap-2">
                <div class="text-left sm:text-center">
                  <p class="font-display text-lg font-bold text-ink">{box.weight}</p>
                  <p class="text-xs text-ink-muted">Mix 5 druhů</p>
                </div>
                <p class="font-display text-xl sm:text-2xl font-bold text-brand">{box.price}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- 5 letošních druhů -->
      <div class="mt-12">
        <div class="mb-6">
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-ink">Letošní druhy</h2>
          <p class="text-sm text-ink-muted mt-1">Všech 5 druhů je součástí každé vánoční krabičky</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">
          {
            CHRISTMAS_COOKIES.map((cookie) => (
              <article class="reveal rounded-[var(--radius-card)] bg-surface border border-line p-4 sm:p-5 flex gap-4 items-start">
                {cookie.photo ? (
                  <div class="shrink-0 w-24 h-24 sm:w-28 sm:h-28 rounded-xl overflow-hidden border border-line bg-sand">
                    <img
                      src={withBase(cookie.photo.src)}
                      alt={cookie.photo.alt}
                      loading="lazy"
                      width="240"
                      height="240"
                      class="w-full h-full object-cover"
                    />
                  </div>
                ) : (
                  <PhotoPlaceholder
                    aspect="1/1"
                    label="Foto druhu"
                    compact
                    class="shrink-0 w-24 h-24 sm:w-28 sm:h-28 rounded-xl"
                  />
                )}

                <div class="min-w-0">
                  <h3 class="font-display text-xl font-bold text-ink">{cookie.name}</h3>
                  <p class="mt-1.5 text-sm text-ink-soft leading-relaxed">
                    <span class="font-semibold text-ink">Složení:</span> {cookie.ingredients}
                  </p>
                  {cookie.note && (
                    <p class="mt-1 text-xs italic text-ink-muted">{cookie.note}</p>
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Hotové krabičky (decentní placeholdery dle D2) -->
      <div class="mt-12">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-ink mb-4">Hotové krabičky</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {
            ['Krabička 300 g', 'Krabička 500 g', 'Krabička 1 000 g'].map((boxLabel) => (
              <PhotoPlaceholder
                aspect="4/3"
                label={`Foto: ${boxLabel}`}
                class="reveal rounded-[var(--radius-card)]"
              />
            ))
          }
        </div>
      </div>

      <OrderCta
        title="Chcete si rezervovat vánoční cukroví?"
        description="Objednávky přijímám telefonicky, přes WhatsApp nebo e-mailem. Společně domluvíme gramáž a termín převzetí na Praze 7."
        buttonLabel="Objednat vánoční cukroví"
      />
    </div>
  </section>
</Layout>
