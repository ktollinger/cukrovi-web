---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHero from '../components/PageHero.astro';
import OrderCta from '../components/OrderCta.astro';
import { DESSERT_SLICES, DESSERT_SLICE_PRICE } from '../data/products';
import { withBase } from '../data/site';
---

<Layout
  title="Dezerty (klínky) | RAWTÍK – Raw dezerty ke kávě"
  description="Jednotlivé klínky raw dezertů ke kávě za 100 Kč/ks. V nabídce vždy 3 druhy: Snickers / Slaný arašíd, Makový dezert a Ovocný dort."
  currentPath="/dezerty"
>
  <section class="pt-6 pb-12 sm:pt-10 sm:pb-16">
    <div class="max-w-5xl mx-auto px-4">
      <Breadcrumbs
        items={[
          { label: 'Domů', href: '/' },
          { label: 'Nabídka a ceník', href: '/#nabidka' },
          { label: 'Dezerty' },
        ]}
      />

      <PageHero
        title="Dezerty"
        lead="Chcete si dát jen jeden nebo pár kousků ke kávě? V nabídce jsou vždy tři druhy jednotlivých dezertů."
        imageSrc="/images/dezerty/uvodni-dezerty.webp"
        imageAlt="Výběr jednotlivých klínků raw dezertů Rawtík"
        viewTransitionName="cat-dezerty"
      >
        <div class="inline-flex items-baseline gap-3 px-4 py-2.5 rounded-xl bg-surface border border-line">
          <span class="text-sm font-medium text-ink-soft">Cena za 1 klínek:</span>
          <span class="font-display text-2xl font-bold text-brand">{DESSERT_SLICE_PRICE}</span>
        </div>
      </PageHero>

      <!-- Jednotlivé druhy dezertů -->
      <div class="mt-12">
        <div class="mb-6">
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-ink">Jednotlivé dezerty</h2>
          <p class="text-sm text-ink-muted mt-1">Vždy 3 druhy v aktuální nabídce</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {
            DESSERT_SLICES.map((slice) => (
              <article class="reveal rounded-[var(--radius-card)] overflow-hidden bg-surface border border-line flex flex-col">
                <div class="aspect-[4/3] bg-sand overflow-hidden">
                  <img
                    src={withBase(slice.photo.src)}
                    alt={slice.photo.alt}
                    loading="lazy"
                    width="800"
                    height="600"
                    class="w-full h-full object-cover"
                  />
                </div>
                <div class="p-5 flex-1 flex flex-col justify-between gap-3">
                  <div>
                    <h3 class="font-display text-xl font-bold text-ink">{slice.name}</h3>
                    <p class="mt-1.5 text-sm text-ink-soft leading-relaxed">{slice.note}</p>
                  </div>
                  <p class="pt-3 border-t border-line text-sm font-semibold text-brand">
                    1 ks: {DESSERT_SLICE_PRICE}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <OrderCta
        title="Máte chuť na něco sladkého ke kávě?"
        description="Napište nebo zavolejte a domluvíme počet kousků a vyzvednutí na Praze 7 – Holešovice."
        buttonLabel="Objednat dezert"
      />
    </div>
  </section>
</Layout>
