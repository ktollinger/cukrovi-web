---
import Layout from '../layouts/Layout.astro';
import CakeDetailModal from '../components/CakeDetailModal.astro';
import { CAKE_PRICES, WHOLE_CAKES } from '../data/products';
import { getWhatsAppUrl, withBase } from '../data/site';

const fruitCakes = WHOLE_CAKES.filter((c) => c.category === 'ovocny');
const nonFruitCakes = WHOLE_CAKES.filter((c) => c.category === 'neovocny');
const whatsappLink = getWhatsAppUrl('Dobrý den, ráda bych si objednala celý raw dort (příchuť a velikost 18/24 cm): ');
---

<Layout
  title="Celé dorty | RAWTÍK – Raw dorty bez lepku a laktózy"
  description="9 druhů raw dortů ve velikostech 18 cm (750 Kč) a 24 cm (1 200 Kč). Ovocné i čokoládové a ořechové varianty z kvalitních surovin."
  currentPath="/cele-dorty"
>
  <section class="pt-6 pb-12 sm:pt-10 sm:pb-16">
    <div class="max-w-5xl mx-auto px-4">
      <!-- Drobečková navigace -->
      <nav aria-label="Drobečková navigace" class="text-xs sm:text-sm text-[#7A726C] mb-5">
        <a href={withBase('/')} class="hover:text-[#8B2635]">Domů</a>
        <span class="mx-1.5">/</span>
        <a href={withBase('/#nabidka')} class="hover:text-[#8B2635]">Nabídka a ceník</a>
        <span class="mx-1.5">/</span>
        <span class="text-[#2C2725] font-medium">Celé dorty</span>
      </nav>

      <!-- 1. Úvodní foto + 2. Krátký úvodní text -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 space-y-4">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#8B2635]/10 text-[#8B2635] text-xs font-bold uppercase tracking-wider">
            Bez lepku • Bez laktózy • Raw med
          </span>
          <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[#2C2725] leading-tight">
            Celé dorty
          </h1>
          <p class="text-base sm:text-lg text-[#5A534E] leading-relaxed">
            Dorty plné chuti, připravené z kvalitních surovin. Vyberte si svou oblíbenou příchuť a velikost a dopřejte si sladké potěšení podle svého gusta.
          </p>
          <p class="text-sm text-[#7A726C]">
            Všechny druhy dortů jsou dostupné v obou uvedených velikostech. Kliknutím na vybraný dort si zobrazíte další fotografie i detail složení.
          </p>
        </div>

        <div class="lg:col-span-6">
          <div class="rounded-3xl overflow-hidden border border-[#E8E2D8] shadow-md aspect-[4/3] bg-[#F3ECE2]">
            <img
              src={withBase('/images/dorty/uvodni-dort.webp')}
              alt="Úvodní fotografie celého raw dortu Rawtík"
              fetchpriority="high"
              width="1200"
              height="900"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      </div>

      <!-- 3. Velikosti a ceník dortů -->
      <div class="mt-12 rounded-3xl bg-white border border-[#E8E2D8] p-6 sm:p-8 shadow-xs">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#2C2725] mb-6 text-center">
          Velikosti a ceník dortů
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {
            CAKE_PRICES.map((item, idx) => (
              <div
                class:list={[
                  'rounded-2xl p-5 text-center border',
                  idx === 1
                    ? 'bg-[#8B2635] text-white border-[#8B2635] shadow-md'
                    : 'bg-[#FAF7F2] text-[#2C2725] border-[#E8E2D8]',
                ]}
              >
                <p class="font-serif text-xl font-bold">{item.label}</p>
                <p
                  class:list={[
                    'text-xs mt-1',
                    idx === 1 ? 'text-white/80' : 'text-[#7A726C]',
                  ]}
                >
                  {item.portions}
                </p>
                <p
                  class:list={[
                    'font-serif text-2xl sm:text-3xl font-bold mt-2',
                    idx === 1 ? 'text-[#F5D6B4]' : 'text-[#8B2635]',
                  ]}
                >
                  {item.price}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- 4a. Ovocné dorty -->
      <div class="mt-14">
        <div class="mb-6">
          <p class="text-xs font-bold uppercase tracking-widest text-[#9A5B32] mb-1">Svěží kombinace</p>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#2C2725]">Ovocné dorty</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            fruitCakes.map((cake) => (
              <article class="rounded-2xl overflow-hidden bg-white border border-[#E8E2D8] shadow-xs hover:shadow-md hover:border-[#C58B55] transition-all flex flex-col">
                <button
                  type="button"
                  data-open-cake={cake.id}
                  class="relative aspect-[4/3] bg-[#F3ECE2] overflow-hidden text-left cursor-pointer group"
                  aria-label={`Zobrazit fotografie a detail dortu ${cake.name}`}
                >
                  <img
                    src={withBase(cake.photos[0].src)}
                    alt={cake.photos[0].alt}
                    loading="lazy"
                    width="800"
                    height="600"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                  {cake.photos.length > 1 && (
                    <span class="absolute bottom-2.5 right-2.5 px-2.5 py-1 rounded-full bg-[#2C2725]/80 text-white text-[11px] font-semibold backdrop-blur-xs">
                      {cake.photos.length} fotek
                    </span>
                  )}
                </button>
                <div class="p-5 flex-1 flex flex-col justify-between gap-3">
                  <div>
                    <h3 class="font-serif text-xl font-bold text-[#2C2725]">{cake.name}</h3>
                    <p class="mt-1.5 text-sm text-[#5A534E] leading-relaxed">{cake.ingredients}</p>
                  </div>
                  <button
                    type="button"
                    data-open-cake={cake.id}
                    class="self-start text-sm font-bold text-[#8B2635] hover:text-[#721E2B] cursor-pointer"
                  >
                    {cake.photos.length > 1 ? `Prohlédnout všechny fotky (${cake.photos.length}) →` : 'Detail dortu →'}
                  </button>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <!-- 4b. Neovocné dorty -->
      <div class="mt-14">
        <div class="mb-6">
          <p class="text-xs font-bold uppercase tracking-widest text-[#9A5B32] mb-1">Čokoláda, oříšky &amp; mák</p>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#2C2725]">Neovocné dorty</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            nonFruitCakes.map((cake) => (
              <article class="rounded-2xl overflow-hidden bg-white border border-[#E8E2D8] shadow-xs hover:shadow-md hover:border-[#C58B55] transition-all flex flex-col">
                <button
                  type="button"
                  data-open-cake={cake.id}
                  class="relative aspect-[4/3] bg-[#F3ECE2] overflow-hidden text-left cursor-pointer group"
                  aria-label={`Zobrazit fotografie a detail dortu ${cake.name}`}
                >
                  <img
                    src={withBase(cake.photos[0].src)}
                    alt={cake.photos[0].alt}
                    loading="lazy"
                    width="800"
                    height="600"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                  {cake.photos.length > 1 && (
                    <span class="absolute bottom-2.5 right-2.5 px-2.5 py-1 rounded-full bg-[#2C2725]/80 text-white text-[11px] font-semibold backdrop-blur-xs">
                      {cake.photos.length} fotek
                    </span>
                  )}
                </button>
                <div class="p-5 flex-1 flex flex-col justify-between gap-3">
                  <div>
                    <h3 class="font-serif text-xl font-bold text-[#2C2725]">{cake.name}</h3>
                    <p class="mt-1.5 text-sm text-[#5A534E] leading-relaxed">{cake.ingredients}</p>
                  </div>
                  <button
                    type="button"
                    data-open-cake={cake.id}
                    class="self-start text-sm font-bold text-[#8B2635] hover:text-[#721E2B] cursor-pointer"
                  >
                    {cake.photos.length > 1 ? `Prohlédnout všechny fotky (${cake.photos.length}) →` : 'Detail dortu →'}
                  </button>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <!-- 5. Tlačítko OBJEDNAT DORT -->
      <div class="mt-14 rounded-3xl bg-[#8B2635] text-white p-7 sm:p-10 text-center space-y-4 shadow-md">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold">Máte vybranou příchuť?</h2>
        <p class="text-sm sm:text-base text-white/85 max-w-xl mx-auto">
          Objednávejte prosím minimálně 2 pracovní dny předem. Ráda s vámi doladím velikost i případné extra zdobení.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-3 pt-2">
          <a
            href={withBase('/#jak-objednat')}
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-xl text-base font-bold bg-white text-[#8B2635] hover:bg-[#FAF7F2] transition-colors"
          >
            Objednat dort
          </a>
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-xl text-base font-bold bg-[#25D366] text-white hover:bg-[#1EBE5D] transition-colors"
          >
            Napsat na WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <CakeDetailModal />
</Layout>
