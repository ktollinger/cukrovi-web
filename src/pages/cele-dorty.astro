---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHero from '../components/PageHero.astro';
import CakeCard from '../components/CakeCard.astro';
import OrderCta from '../components/OrderCta.astro';
import CakeDetailModal from '../components/CakeDetailModal.astro';
import { CAKE_PRICES, WHOLE_CAKES } from '../data/products';
---

<Layout
  title="Celé dorty | RAWTÍK – Raw dorty bez lepku a laktózy"
  description="9 druhů raw dortů ve velikostech 18 cm (750 Kč) a 24 cm (1 200 Kč). Ovocné i čokoládové a ořechové varianty z kvalitních surovin."
  currentPath="/cele-dorty"
>
  <section class="pt-6 pb-12 sm:pt-10 sm:pb-16">
    <div class="max-w-5xl mx-auto px-4">
      <Breadcrumbs
        items={[
          { label: 'Domů', href: '/' },
          { label: 'Nabídka a ceník', href: '/#nabidka' },
          { label: 'Celé dorty' },
        ]}
      />

      <PageHero
        title="Celé dorty"
        lead="Dorty plné chuti, připravené z kvalitních surovin. Vyberte si svou oblíbenou příchuť a velikost a dopřejte si sladké potěšení podle svého gusta."
        imageSrc="/images/dorty/uvodni-dort.webp"
        imageAlt="Úvodní fotografie celého raw dortu Rawtík"
        viewTransitionName="cat-cele-dorty"
      >
        <p class="text-sm text-ink-muted">
          Všechny druhy jsou dostupné v obou velikostech. Klepnutím na dort zobrazíte všechny fotografie a kompletní složení.
        </p>
      </PageHero>

      <!-- Kompaktní řádek ceníku -->
      <div class="reveal mt-10 rounded-[var(--radius-card)] bg-surface border border-line p-4 sm:p-5">
        <div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-line text-center">
          {
            CAKE_PRICES.map((item) => (
              <div class="py-3 sm:py-1 sm:px-4 flex sm:flex-col items-center justify-between sm:justify-center gap-2">
                <div class="text-left sm:text-center">
                  <p class="font-display font-bold text-ink">{item.label}</p>
                  <p class="text-xs text-ink-muted">{item.portions}</p>
                </div>
                <p class="font-display text-xl sm:text-2xl font-bold text-brand">{item.price}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Katalog dortů s čistě CSS filtrem (:has()) -->
      <div class="CakeCatalog mt-12">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
          <div>
            <h2 class="font-display text-2xl sm:text-3xl font-bold text-ink">Příchutě v nabídce</h2>
            <p class="text-sm text-ink-muted mt-1">9 druhů raw dortů bez lepku, laktózy a rafinovaného cukru</p>
          </div>

          <div
            class="inline-flex p-1 rounded-full bg-sand border border-line self-start sm:self-auto"
            role="radiogroup"
            aria-label="Filtrovat druhy dortů"
          >
            <input type="radio" name="cake-filter" id="filter-all" class="peer/all sr-only" checked />
            <label
              for="filter-all"
              class="px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold text-ink-soft cursor-pointer transition-colors peer-checked/all:bg-surface peer-checked/all:text-brand peer-checked/all:shadow-xs"
            >
              Vše (9)
            </label>

            <input type="radio" name="cake-filter" id="filter-ovocny" class="peer/fruit sr-only" />
            <label
              for="filter-ovocny"
              class="px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold text-ink-soft cursor-pointer transition-colors peer-checked/fruit:bg-surface peer-checked/fruit:text-brand peer-checked/fruit:shadow-xs"
            >
              Ovocné (5)
            </label>

            <input type="radio" name="cake-filter" id="filter-neovocny" class="peer/nonfruit sr-only" />
            <label
              for="filter-neovocny"
              class="px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold text-ink-soft cursor-pointer transition-colors peer-checked/nonfruit:bg-surface peer-checked/nonfruit:text-brand peer-checked/nonfruit:shadow-xs"
            >
              Neovocné (4)
            </label>
          </div>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-6">
          {WHOLE_CAKES.map((cake) => <CakeCard cake={cake} />)}
        </div>
      </div>

      <OrderCta
        title="Máte vybranou příchuť?"
        description="Objednávejte prosím minimálně 2 pracovní dny předem. Ráda s vámi doladím velikost i případné extra zdobení."
        buttonLabel="Objednat dort"
      />
    </div>
  </section>

  <CakeDetailModal />
</Layout>
