---
import Layout from '../layouts/Layout.astro';
import OrderSection from '../components/OrderSection.astro';
import Button from '../components/ui/Button.astro';
import PhotoPlaceholder from '../components/ui/PhotoPlaceholder.astro';
import { ABOUT_PARAGRAPHS, OFFER_CATEGORIES } from '../data/products';
import { SITE, withBase } from '../data/site';
---

<Layout
  title="RAWTÍK – Vánoční cukroví & raw dorty bez výčitek | Praha 7"
  currentPath="/"
>
  <!-- 1. DOMŮ (Úvodní Hero s jemným tónovým přechodem krém → perník) -->
  <section class="pt-8 pb-12 sm:pt-14 sm:pb-16 border-b border-line bg-gradient-to-b from-cream to-sand/45">
    <div class="max-w-5xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        <div class="lg:col-span-6">
          {
            SITE.christmasSeason && (
              <p class="text-xs font-bold uppercase tracking-widest text-cinnamon mb-3">
                Vánoce 2026 • Ruční výroba v Holešovicích
              </p>
            )
          }

          <h1 class="font-display text-4xl sm:text-5xl font-bold text-ink leading-[1.1] tracking-tight">
            {
              SITE.christmasSeason ? (
                <>
                  Vánoční cukroví <span class="text-brand italic font-normal">bez výčitek</span>
                </>
              ) : (
                <>
                  Raw dorty <span class="text-brand italic font-normal">bez výčitek</span>
                </>
              )
            }
          </h1>

          <ul class="mt-6 space-y-2.5 text-base text-ink-soft">
            <li class="flex items-start gap-2.5">
              <span class="mt-2 w-1.5 h-1.5 rounded-full bg-ginger shrink-0" aria-hidden="true"></span>
              <span>Z kvalitních surovin, slazené pouze <strong class="text-ink">datlemi a medem od včelaře</strong></span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-2 w-1.5 h-1.5 rounded-full bg-ginger shrink-0" aria-hidden="true"></span>
              <span>Výborná chuť a složení, ze kterého bude mít radost i vaše tělo</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-2 w-1.5 h-1.5 rounded-full bg-ginger shrink-0" aria-hidden="true"></span>
              <span>Přirozeně <strong class="text-ink">bez lepku i laktózy</strong></span>
            </li>
          </ul>

          <div class="mt-7">
            <Button href="#nabidka" variant="primary" size="lg" class="w-full sm:w-auto">
              <span>Prohlédnout nabídku</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path d="M19 9l-7 7-7-7" />
              </svg>
            </Button>
          </div>
        </div>

        <!-- Pravý vizuál: decentní placeholder krabičky dle náčrtku (D3) -->
        <div class="lg:col-span-6">
          <PhotoPlaceholder
            aspect="4/3"
            class="rounded-[var(--radius-card)]"
            viewTransitionName={SITE.christmasSeason ? 'cat-vanocni-cukrovi' : undefined}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 2. NABÍDKA A CENÍK (Rozcestník se 3 kartami kategorií bez odznaků a zoomu) -->
  <section id="nabidka" class="scroll-mt-20 py-14 sm:py-16">
    <div class="max-w-5xl mx-auto px-4">
      <div class="max-w-2xl mb-9">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-ink">
          Nabídka a ceník
        </h2>
        <p class="mt-2 text-ink-soft">
          Vyberte si kategorii a prohlédněte si fotografie, složení i kompletní ceník.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          OFFER_CATEGORIES.map((category) => (
            <a
              href={withBase(category.path)}
              class="reveal group rounded-[var(--radius-card)] overflow-hidden bg-surface border border-line hover:border-ginger hover:shadow-md transition-all flex flex-col focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
            >
              <div
                class="aspect-[4/3] bg-sand overflow-hidden"
                style={`view-transition-name: cat-${category.id}`}
              >
                {category.image ? (
                  <img
                    src={withBase(category.image.src)}
                    alt={category.image.alt}
                    loading="lazy"
                    width="800"
                    height="600"
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <PhotoPlaceholder aspect="4/3" class="border-0 w-full h-full" />
                )}
              </div>

              <div class="p-5 flex-1 flex flex-col justify-between gap-4">
                <div>
                  <h3 class="font-display text-2xl font-bold text-ink group-hover:text-brand transition-colors">
                    {category.title}
                  </h3>
                  <p class="mt-1.5 text-sm text-ink-soft leading-relaxed">
                    {category.subtitle}
                  </p>
                </div>

                <div class="flex items-center justify-between pt-3 border-t border-line">
                  <span class="font-display text-lg font-bold text-brand">{category.priceFrom}</span>
                  <span class="text-sm font-semibold text-ink group-hover:text-brand inline-flex items-center gap-1 transition-colors">
                    Zobrazit <span aria-hidden="true">→</span>
                  </span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3. O NÁS (perex + čisté odstavce + 1 velká fotka) -->
  <section id="o-nas" class="scroll-mt-20 py-14 sm:py-16 bg-sand/55 border-t border-line">
    <div class="max-w-5xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <div class="lg:col-span-7 space-y-4">
          <h2 class="font-display text-3xl sm:text-4xl font-bold text-ink">O nás</h2>
          {
            ABOUT_PARAGRAPHS.map((paragraph, idx) => (
              <p
                class:list={[
                  'leading-relaxed',
                  idx === 0
                    ? 'text-lg sm:text-xl font-display text-ink'
                    : 'text-base text-ink-soft',
                ]}
              >
                {paragraph}
              </p>
            ))
          }
        </div>

        <div class="lg:col-span-5 reveal">
          <div class="rounded-[var(--radius-card)] overflow-hidden border border-line aspect-square bg-sand">
            <img
              src={withBase('/images/dorty/malinovy-24cm.webp')}
              alt="Malinový raw dort zdobený ovocem a pistáciemi"
              loading="lazy"
              width="800"
              height="800"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. JAK OBJEDNAT A PŘEVZETÍ -->
  <OrderSection />

  <!-- 5. KONTAKT -->
  <section id="kontakt" class="scroll-mt-20 py-14 sm:py-16">
    <div class="max-w-5xl mx-auto px-4">
      <div class="reveal rounded-[var(--radius-card)] bg-surface border border-line p-6 sm:p-10">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
          <div class="md:col-span-7 space-y-3">
            <h2 class="font-display text-3xl sm:text-4xl font-bold text-ink">Kontakt</h2>
            <p class="text-lg font-semibold text-ink pt-1">{SITE.owner}</p>
            <p class="text-ink-soft">{SITE.location}</p>

            <dl class="pt-2 space-y-2 text-sm sm:text-base">
              <div class="flex flex-wrap gap-x-2">
                <dt class="text-ink-muted">Telefon / WhatsApp:</dt>
                <dd class="font-semibold text-ink">
                  <a href={SITE.phoneHref} class="hover:text-brand transition-colors">
                    {SITE.phoneDisplay}
                  </a>
                </dd>
              </div>
              <div class="flex flex-wrap gap-x-2">
                <dt class="text-ink-muted">E-mail:</dt>
                <dd class="font-semibold text-ink">
                  <a href={`mailto:${SITE.email}`} class="hover:text-brand transition-colors">
                    {SITE.email}
                  </a>
                </dd>
              </div>
              <div class="flex flex-wrap gap-x-2">
                <dt class="text-ink-muted">IČO:</dt>
                <dd class="font-medium text-ink">{SITE.ico}</dd>
              </div>
            </dl>
          </div>

          <div class="md:col-span-5 rounded-[var(--radius-card)] bg-cream border border-line p-6 text-center space-y-3">
            <p class="text-xs font-semibold uppercase tracking-wider text-cinnamon">Sledujte nás</p>
            <Button href={SITE.instagramUrl} external variant="secondary" size="md" class="w-full whitespace-nowrap">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
              </svg>
              <span>Instagram {SITE.instagramHandle}</span>
            </Button>
            <p class="text-xs text-ink-muted">
              Aktuální fotky dortů, sezónní novinky a zákulisí výroby.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
