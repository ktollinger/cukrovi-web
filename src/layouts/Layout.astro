---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import HeaderDrawer from '../components/HeaderDrawer.astro';
import FontSwitcher from '../components/FontSwitcher.astro';
import { SITE, withBase } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = 'RAWTÍK – Raw dorty a vánoční cukroví bez výčitek | Praha 7',
  description = 'Ručně vyráběné raw dorty, dezerty a vánoční cukroví bez lepku a laktózy, slazené pouze datlemi a raw medem od včelaře. Osobní odběr Praha 7 – Holešovice.',
  currentPath = '/',
} = Astro.props;

const now = new Date();
const buildTime = now.toISOString();
const buildTimeFormatted = now.toUTCString();
const ogImageUrl = Astro.site
  ? new URL(withBase('/images/dorty/uvodni-dort.webp'), Astro.site).toString()
  : withBase('/images/dorty/uvodni-dort.webp');
---

<!doctype html>
<html lang="cs" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="build-time" content={buildTime} />
    <!-- Build timestamp: {buildTimeFormatted} -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <script is:inline>
      try {
        if (localStorage.getItem('rawtik-preview-font') === 'playfair') {
          document.documentElement.dataset.font = 'playfair';
        }
      } catch {}
    </script>
  </head>
  <body class="bg-cream text-ink antialiased selection:bg-brand selection:text-white min-h-svh flex flex-col">
    <FontSwitcher />
    <HeaderDrawer currentPath={currentPath} />

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-line bg-sand/60 py-10 mt-14">
      <div class="max-w-5xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-ink-soft">
        <div class="text-center sm:text-left">
          <p class="font-display font-bold text-brand text-base tracking-wide">{SITE.brand}</p>
          <p class="text-xs text-ink-muted mt-0.5">
            {SITE.owner} • {SITE.location} • IČO: {SITE.ico}
          </p>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-medium">
          <a href={SITE.phoneHref} class="hover:text-brand transition-colors">{SITE.phoneDisplay}</a>
          <span aria-hidden="true" class="text-line">•</span>
          <a href={`mailto:${SITE.email}`} class="hover:text-brand transition-colors">{SITE.email}</a>
          <span aria-hidden="true" class="text-line">•</span>
          <a
            href={SITE.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-brand transition-colors"
          >
            Instagram {SITE.instagramHandle}
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
