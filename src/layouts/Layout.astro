---
import '../styles/global.css';
import HeaderDrawer from '../components/HeaderDrawer.astro';
import { SITE, withBase } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = 'RAWTÍK – Raw dorty a vánoční cukroví bez výčitek | Praha 7',
  description = 'Ručně vyráběné raw dorty, dezerty a vánoční cukroví bez lepku a laktózy, slazené pouze datlemi a raw medem od včelaře. Osobní odběr Praha 7 – Holešovice.',
  currentPath = '/',
} = Astro.props;

const now = new Date();
const buildTime = now.toISOString();
const buildTimeFormatted = now.toUTCString();
---

<!doctype html>
<html lang="cs" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="build-time" content={buildTime} />
    <!-- Build timestamp: {buildTimeFormatted} -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />

    <!-- Google Fonts: Playfair Display + Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#FAF7F2] text-[#2C2725] antialiased selection:bg-[#8B2635] selection:text-white min-h-svh flex flex-col">
    <HeaderDrawer currentPath={currentPath} />

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-[#E8E2D8] bg-[#F3ECE2]/70 py-10 mt-12">
      <div class="max-w-5xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-[#5A534E]">
        <div class="text-center sm:text-left">
          <p class="font-serif font-bold text-[#8B2635] text-base">{SITE.brand}</p>
          <p class="text-xs text-[#7A726C] mt-0.5">
            {SITE.owner} • {SITE.location} • IČO: {SITE.ico}
          </p>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-medium">
          <a href={SITE.phoneHref} class="hover:text-[#8B2635] transition-colors">{SITE.phoneDisplay}</a>
          <span aria-hidden="true" class="text-[#D5CDC2]">•</span>
          <a href={`mailto:${SITE.email}`} class="hover:text-[#8B2635] transition-colors">{SITE.email}</a>
          <span aria-hidden="true" class="text-[#D5CDC2]">•</span>
          <a
            href={SITE.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 hover:text-[#8B2635] transition-colors"
          >
            Instagram {SITE.instagramHandle}
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
