---
import { CAKE_PRICES, WHOLE_CAKES } from '../data/products';
import { getWhatsAppUrl, withBase } from '../data/site';

const cakesWithBase = WHOLE_CAKES.map((cake) => ({
  ...cake,
  photos: cake.photos.map((photo) => ({
    ...photo,
    src: withBase(photo.src),
  })),
  whatsappUrl: getWhatsAppUrl(`Dobrý den, ráda bych si objednala ${cake.name} (velikost 18 cm / 24 cm): `),
}));
---

<!-- Nativní modal s light-dismiss (closedby="any" + fallback pro Safari) -->
<dialog
  id="cake-detail-dialog"
  class="CakeModal"
  closedby="any"
  aria-labelledby="cake-modal-title"
>
  <div class="p-4 sm:p-6">
    <div class="flex items-start justify-between gap-4 pb-3 border-b border-[#E8E2D8]">
      <div>
        <span
          id="cake-modal-category"
          class="inline-block text-[11px] font-bold uppercase tracking-wider text-[#9A5B32] mb-1"
        ></span>
        <h3 id="cake-modal-title" class="font-serif text-2xl sm:text-3xl font-bold text-[#2C2725]"></h3>
      </div>
      <form method="dialog">
        <button
          type="submit"
          aria-label="Zavřít detail dortu"
          class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-[#FAF7F2] border border-[#E8E2D8] text-[#2C2725] hover:text-[#8B2635] hover:border-[#8B2635] transition-colors cursor-pointer"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </form>
    </div>

    <!-- Hlavní fotografie v modalu -->
    <div class="mt-4">
      <div class="relative rounded-2xl overflow-hidden bg-[#F3ECE2] aspect-[4/3]">
        <img
          id="cake-modal-main-img"
          src=""
          alt=""
          fetchpriority="low"
          class="w-full h-full object-cover"
        />
        <p
          id="cake-modal-caption"
          class="absolute bottom-2 left-2 right-2 px-3 py-1.5 rounded-lg bg-[#2C2725]/75 text-white text-xs backdrop-blur-xs empty:hidden"
        ></p>
      </div>

      <!-- Náhledy dalších fotek (zobrazí se, pokud má dort více než 1 foto) -->
      <div id="cake-modal-thumbs" class="mt-3 flex gap-2 overflow-x-auto pb-1"></div>
    </div>

    <!-- Složení a ceník -->
    <div class="mt-5 space-y-4">
      <div class="rounded-xl bg-[#FAF7F2] border border-[#E8E2D8] p-4">
        <h4 class="text-xs font-bold uppercase tracking-wider text-[#9A5B32] mb-1.5">Složení</h4>
        <p id="cake-modal-ingredients" class="text-sm sm:text-base text-[#2C2725] leading-relaxed"></p>
        <p class="mt-2 text-xs text-[#7A726C]">
          Přirozeně bez lepku a laktózy, slazeno pouze raw medem a datlemi.
        </p>
      </div>

      <div class="grid grid-cols-3 gap-2 text-center">
        {
          CAKE_PRICES.map((row) => (
            <div class="rounded-xl bg-[#FAF7F2] border border-[#E8E2D8] p-2.5">
              <p class="text-xs font-semibold text-[#5A534E]">{row.label}</p>
              <p class="font-serif text-base sm:text-lg font-bold text-[#8B2635] mt-0.5">{row.price}</p>
              <p class="text-[11px] text-[#7A726C]">{row.portions}</p>
            </div>
          ))
        }
      </div>

      <div class="flex flex-col sm:flex-row gap-2.5 pt-1">
        <a
          id="cake-modal-wa"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl text-sm font-bold bg-[#25D366] text-white hover:bg-[#1EBE5D] transition-colors"
        >
          Objednat tento dort přes WhatsApp
        </a>
        <a
          href={withBase('/#jak-objednat')}
          data-close-modal
          class="inline-flex items-center justify-center px-5 py-3 rounded-xl text-sm font-semibold bg-[#8B2635] text-white hover:bg-[#721E2B] transition-colors"
        >
          Jak objednat
        </a>
      </div>
    </div>
  </div>
</dialog>

<script id="cakes-catalog-data" type="application/json" set:html={JSON.stringify(cakesWithBase)}></script>

<script>
  interface CakePhoto {
    src: string;
    alt: string;
    caption?: string;
  }
  interface CakeRecord {
    id: string;
    name: string;
    category: 'ovocny' | 'neovocny';
    ingredients: string;
    photos: CakePhoto[];
    whatsappUrl: string;
  }

  const dataEl = document.getElementById('cakes-catalog-data');
  const dialog = document.getElementById('cake-detail-dialog') as HTMLDialogElement | null;
  const titleEl = document.getElementById('cake-modal-title');
  const catEl = document.getElementById('cake-modal-category');
  const ingEl = document.getElementById('cake-modal-ingredients');
  const mainImg = document.getElementById('cake-modal-main-img') as HTMLImageElement | null;
  const captionEl = document.getElementById('cake-modal-caption');
  const thumbsEl = document.getElementById('cake-modal-thumbs');
  const waEl = document.getElementById('cake-modal-wa') as HTMLAnchorElement | null;

  if (dataEl && dialog && titleEl && catEl && ingEl && mainImg && captionEl && thumbsEl && waEl) {
    const cakes: CakeRecord[] = JSON.parse(dataEl.textContent || '[]');
    const cakeById = new Map(cakes.map((c) => [c.id, c]));

    function selectPhoto(photo: CakePhoto, activeIndex: number) {
      mainImg!.src = photo.src;
      mainImg!.alt = photo.alt;
      captionEl!.textContent = photo.caption || '';

      thumbsEl!.querySelectorAll('button').forEach((btn, idx) => {
        btn.setAttribute('aria-current', idx === activeIndex ? 'true' : 'false');
        btn.classList.toggle('ring-2', idx === activeIndex);
        btn.classList.toggle('ring-[#8B2635]', idx === activeIndex);
        btn.classList.toggle('opacity-70', idx !== activeIndex);
      });
    }

    function openCakeModal(cakeId: string) {
      const cake = cakeById.get(cakeId);
      if (!cake) return;

      titleEl!.textContent = cake.name;
      catEl!.textContent = cake.category === 'ovocny' ? 'Ovocný raw dort' : 'Neovocný raw dort';
      ingEl!.textContent = cake.ingredients;
      waEl!.href = cake.whatsappUrl;

      thumbsEl!.innerHTML = '';
      if (cake.photos.length > 1) {
        cake.photos.forEach((photo, idx) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className =
            'shrink-0 w-18 h-14 rounded-lg overflow-hidden border border-[#E8E2D8] cursor-pointer transition-all';
          btn.setAttribute('aria-label', photo.caption || `${cake.name} – foto ${idx + 1}`);
          const img = document.createElement('img');
          img.src = photo.src;
          img.alt = photo.alt;
          img.loading = 'lazy';
          img.fetchPriority = 'low';
          img.className = 'w-full h-full object-cover';
          btn.appendChild(img);
          btn.addEventListener('click', () => selectPhoto(photo, idx));
          thumbsEl!.appendChild(btn);
        });
      }

      if (cake.photos[0]) {
        selectPhoto(cake.photos[0], 0);
      }

      dialog!.showModal();
    }

    document.querySelectorAll<HTMLElement>('[data-open-cake]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const id = trigger.dataset.openCake;
        if (id) openCakeModal(id);
      });
    });

    dialog.querySelectorAll('[data-close-modal]').forEach((el) => {
      el.addEventListener('click', () => dialog.close());
    });

    // Mandatory fallback for browsers without <dialog closedby="any"> support (e.g. Safari)
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      dialog.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const rect = dialog.getBoundingClientRect();
        const isDialogContent =
          rect.top <= event.clientY &&
          event.clientY <= rect.top + rect.height &&
          rect.left <= event.clientX &&
          event.clientX <= rect.left + rect.width;
        if (isDialogContent) return;
        dialog.close();
      });
    }
  }
</script>
