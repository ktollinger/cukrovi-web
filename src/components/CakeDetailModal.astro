---
import Button from './ui/Button.astro';
import { CAKE_PRICES, WHOLE_CAKES } from '../data/products';
import { withBase } from '../data/site';

const cakesWithBase = WHOLE_CAKES.map((cake) => ({
  ...cake,
  photos: cake.photos.map((photo) => ({
    ...photo,
    src: withBase(photo.src),
  })),
}));
---

<dialog
  id="cake-detail-dialog"
  class="CakeModal"
  closedby="any"
  aria-labelledby="cake-modal-title"
>
  <div class="p-4 sm:p-6">
    <!-- Úchyt pro mobilní spodní panel -->
    <div class="sm:hidden w-10 h-1 rounded-full bg-line mx-auto mb-3" aria-hidden="true"></div>

    <div class="flex items-start justify-between gap-4 pb-3 border-b border-line">
      <div>
        <span id="cake-modal-category" class="block text-xs font-semibold text-cinnamon mb-0.5"></span>
        <h3 id="cake-modal-title" class="font-display text-2xl sm:text-3xl font-bold text-ink"></h3>
      </div>
      <form method="dialog">
        <button
          type="submit"
          aria-label="Zavřít detail dortu"
          class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-cream border border-line text-ink hover:text-brand hover:border-brand transition-colors cursor-pointer"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </form>
    </div>

    <!-- Swipovatelná galerie (scroll-snap) + šipky pro desktop + tečky -->
    <div class="mt-4 relative">
      <div
        id="cake-modal-track"
        class="GalleryTrack rounded-[var(--radius-card)] bg-sand aspect-[4/3] border border-line"
      ></div>

      <button
        id="cake-modal-prev"
        type="button"
        aria-label="Předchozí fotografie"
        class="hidden sm:inline-flex items-center justify-center w-9 h-9 rounded-full bg-surface/90 border border-line text-ink hover:text-brand shadow-sm absolute left-2.5 top-1/2 -translate-y-1/2 cursor-pointer"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M15 18l-6-6 6-6" />
        </svg>
      </button>

      <button
        id="cake-modal-next"
        type="button"
        aria-label="Další fotografie"
        class="hidden sm:inline-flex items-center justify-center w-9 h-9 rounded-full bg-surface/90 border border-line text-ink hover:text-brand shadow-sm absolute right-2.5 top-1/2 -translate-y-1/2 cursor-pointer"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M9 18l6-6-6-6" />
        </svg>
      </button>

      <div id="cake-modal-dots" class="mt-3 flex items-center justify-center gap-1.5 min-h-4"></div>
    </div>

    <!-- Složení a ceník -->
    <div class="mt-4 space-y-4">
      <div class="rounded-xl bg-cream border border-line p-4">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-cinnamon mb-1">Složení</h4>
        <p id="cake-modal-ingredients" class="text-sm sm:text-base text-ink leading-relaxed"></p>
        <p class="mt-2 text-xs text-ink-muted">
          Přirozeně bez lepku a laktózy, slazeno pouze raw medem a datlemi.
        </p>
      </div>

      <div class="grid grid-cols-3 gap-2 text-center">
        {
          CAKE_PRICES.map((row) => (
            <div class="rounded-xl bg-cream border border-line p-2.5">
              <p class="text-xs font-semibold text-ink-soft">{row.label}</p>
              <p class="font-display text-base sm:text-lg font-bold text-brand mt-0.5">{row.price}</p>
              <p class="text-xs text-ink-muted">{row.portions}</p>
            </div>
          ))
        }
      </div>

      <div class="pt-1">
        <Button href="/#jak-objednat" variant="primary" size="lg" class="w-full" data-close-modal>
          Objednat dort
        </Button>
      </div>
    </div>
  </div>
</dialog>

<script id="cakes-catalog-data" type="application/json" set:html={JSON.stringify(cakesWithBase)}></script>

<script>
  interface CakePhoto {
    src: string;
    alt: string;
    caption?: string;
  }
  interface CakeRecord {
    id: string;
    name: string;
    category: 'ovocny' | 'neovocny';
    ingredients: string;
    photos: CakePhoto[];
  }

  const dataEl = document.getElementById('cakes-catalog-data');
  const dialog = document.getElementById('cake-detail-dialog') as HTMLDialogElement | null;
  const titleEl = document.getElementById('cake-modal-title');
  const catEl = document.getElementById('cake-modal-category');
  const ingEl = document.getElementById('cake-modal-ingredients');
  const trackEl = document.getElementById('cake-modal-track');
  const dotsEl = document.getElementById('cake-modal-dots');
  const prevBtn = document.getElementById('cake-modal-prev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('cake-modal-next') as HTMLButtonElement | null;

  if (dataEl && dialog && titleEl && catEl && ingEl && trackEl && dotsEl && prevBtn && nextBtn) {
    const cakes: CakeRecord[] = JSON.parse(dataEl.textContent || '[]');
    const cakeById = new Map(cakes.map((c) => [c.id, c]));
    let slideObserver: IntersectionObserver | null = null;
    let activeSlideIndex = 0;

    function setActiveDot(index: number) {
      activeSlideIndex = index;
      dotsEl!.querySelectorAll('button').forEach((dot, idx) => {
        const current = idx === index;
        dot.setAttribute('aria-current', String(current));
        dot.classList.toggle('bg-brand', current);
        dot.classList.toggle('w-5', current);
        dot.classList.toggle('bg-line', !current);
        dot.classList.toggle('w-2', !current);
      });
    }

    function scrollToSlide(index: number) {
      const slide = trackEl!.children[index] as HTMLElement | undefined;
      if (slide) {
        trackEl!.scrollTo({ left: slide.offsetLeft, behavior: 'smooth' });
      }
    }

    function openCakeModal(cakeId: string) {
      const cake = cakeById.get(cakeId);
      if (!cake) return;

      titleEl!.textContent = cake.name;
      catEl!.textContent = cake.category === 'ovocny' ? 'Ovocný raw dort' : 'Neovocný raw dort';
      ingEl!.textContent = cake.ingredients;

      slideObserver?.disconnect();
      trackEl!.innerHTML = '';
      dotsEl!.innerHTML = '';
      activeSlideIndex = 0;

      const hasMultiple = cake.photos.length > 1;
      prevBtn!.style.display = hasMultiple ? '' : 'none';
      nextBtn!.style.display = hasMultiple ? '' : 'none';

      cake.photos.forEach((photo, idx) => {
        const slide = document.createElement('div');
        slide.className = 'GallerySlide relative w-full h-full';

        const img = document.createElement('img');
        img.src = photo.src;
        img.alt = photo.alt;
        img.fetchPriority = idx === 0 ? 'auto' : 'low';
        if (idx > 0) img.loading = 'lazy';
        img.className = 'w-full h-full object-cover';
        slide.appendChild(img);

        if (photo.caption) {
          const cap = document.createElement('p');
          cap.textContent = photo.caption;
          cap.className =
            'absolute bottom-2.5 left-2.5 px-3 py-1 rounded-lg bg-ink/75 text-white text-xs backdrop-blur-xs';
          slide.appendChild(cap);
        }

        trackEl!.appendChild(slide);

        if (hasMultiple) {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'h-2 rounded-full transition-all cursor-pointer';
          dot.setAttribute('aria-label', `Zobrazit fotografii ${idx + 1}`);
          dot.addEventListener('click', () => scrollToSlide(idx));
          dotsEl!.appendChild(dot);
        }
      });

      if (hasMultiple) {
        setActiveDot(0);
        slideObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting && entry.intersectionRatio >= 0.6) {
                const idx = Array.from(trackEl!.children).indexOf(entry.target);
                if (idx >= 0) setActiveDot(idx);
              }
            });
          },
          { root: trackEl, threshold: 0.6 }
        );
        Array.from(trackEl!.children).forEach((el) => slideObserver!.observe(el));
      }

      trackEl!.scrollLeft = 0;
      dialog!.showModal();
    }

    prevBtn.addEventListener('click', () => {
      const next = Math.max(0, activeSlideIndex - 1);
      scrollToSlide(next);
    });

    nextBtn.addEventListener('click', () => {
      const count = trackEl.children.length;
      const next = Math.min(count - 1, activeSlideIndex + 1);
      scrollToSlide(next);
    });

    document.querySelectorAll<HTMLElement>('[data-open-cake]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const id = trigger.dataset.openCake;
        if (id) openCakeModal(id);
      });
    });

    dialog.querySelectorAll('[data-close-modal]').forEach((el) => {
      el.addEventListener('click', () => dialog.close());
    });

    if (!('closedBy' in HTMLDialogElement.prototype)) {
      dialog.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const rect = dialog.getBoundingClientRect();
        const isDialogContent =
          rect.top <= event.clientY &&
          event.clientY <= rect.top + rect.height &&
          rect.left <= event.clientX &&
          event.clientX <= rect.left + rect.width;
        if (isDialogContent) return;
        dialog.close();
      });
    }
  }
</script>
