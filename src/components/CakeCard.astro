---
import type { WholeCake } from '../data/products';
import { withBase } from '../data/site';

interface Props {
  cake: WholeCake;
}

const { cake } = Astro.props;
const photoCount = cake.photos.length;
---

<article
  data-cake-category={cake.category}
  class="reveal rounded-[var(--radius-card)] overflow-hidden bg-surface border border-line hover:border-ginger hover:shadow-md transition-all"
>
  <button
    type="button"
    data-open-cake={cake.id}
    class="w-full h-full flex flex-col text-left cursor-pointer group focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
    aria-label={`Zobrazit fotografie a detail dortu ${cake.name}`}
  >
    <div class="relative aspect-[4/5] w-full bg-sand overflow-hidden">
      <img
        src={withBase(cake.photos[0].src)}
        alt={cake.photos[0].alt}
        loading="lazy"
        width="800"
        height="1000"
        class="w-full h-full object-cover"
      />
      {
        photoCount > 1 && (
          <span class="absolute bottom-2.5 right-2.5 px-2.5 py-1 rounded-full bg-ink/75 text-white text-xs font-medium backdrop-blur-xs">
            +{photoCount - 1} foto
          </span>
        )
      }
    </div>

    <div class="p-3.5 sm:p-5 flex-1 flex flex-col justify-between gap-2">
      <div>
        <h3 class="font-display text-base sm:text-xl font-bold text-ink group-hover:text-brand transition-colors">
          {cake.name}
        </h3>
        <p class="mt-1 text-xs sm:text-sm text-ink-soft line-clamp-2 leading-relaxed">
          {cake.ingredients}
        </p>
      </div>
      <span class="text-xs sm:text-sm font-semibold text-brand inline-flex items-center gap-1 pt-1">
        Detail a složení <span aria-hidden="true">→</span>
      </span>
    </div>
  </button>
</article>
