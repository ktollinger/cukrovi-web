<!-- Dočasný přepínač písma nadpisů (Fraunces / Playfair) pro výběr Andreou -->
<div
  class="fixed bottom-4 left-4 z-30 inline-flex items-center gap-1 p-1 rounded-full bg-surface/95 backdrop-blur-md border border-line shadow-md text-xs"
  role="group"
  aria-label="Náhled písma nadpisů"
>
  <span class="pl-2.5 pr-1 text-ink-muted font-medium hidden sm:inline">Písmo:</span>
  <button
    type="button"
    data-set-font="fraunces"
    aria-pressed="true"
    class="px-2.5 py-1 rounded-full font-semibold transition-colors cursor-pointer"
  >
    Fraunces
  </button>
  <button
    type="button"
    data-set-font="playfair"
    aria-pressed="false"
    class="px-2.5 py-1 rounded-full font-semibold transition-colors cursor-pointer"
  >
    Playfair
  </button>
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-set-font]');

  function syncButtons(active: string) {
    buttons.forEach((btn) => {
      const isMatch = btn.dataset.setFont === active;
      btn.setAttribute('aria-pressed', String(isMatch));
      btn.classList.toggle('bg-brand', isMatch);
      btn.classList.toggle('text-white', isMatch);
      btn.classList.toggle('text-ink-soft', !isMatch);
      btn.classList.toggle('hover:text-ink', !isMatch);
    });
  }

  const initial = document.documentElement.dataset.font || 'fraunces';
  syncButtons(initial);

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const font = btn.dataset.setFont || 'fraunces';
      if (font === 'playfair') {
        document.documentElement.dataset.font = 'playfair';
      } else {
        delete document.documentElement.dataset.font;
      }
      try {
        localStorage.setItem('rawtik-preview-font', font);
      } catch {}
      syncButtons(font);
    });
  });
</script>
