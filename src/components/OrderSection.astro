---
import { SITE, getWhatsAppUrl } from '../data/site';

interface Props {
  prefill?: string;
}

const {
  prefill = 'Dobrý den, ráda bych si objednala u Rawtík (druh, velikost/množství a požadovaný termín): ',
} = Astro.props;

const whatsappLink = getWhatsAppUrl(prefill);
---

<section id="jak-objednat" class="scroll-mt-20 py-14 sm:py-16 bg-white border-y border-[#E8E2D8]">
  <div class="max-w-5xl mx-auto px-4">
    <div class="max-w-2xl mb-8">
      <p class="text-xs font-bold uppercase tracking-widest text-[#9A5B32] mb-2">Objednávky &amp; vyzvednutí</p>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#2C2725]">
        Jak objednat a převzetí
      </h2>
      <p class="mt-3 text-[#5A534E] leading-relaxed">
        Objednávky přijímám prostřednictvím telefonu, WhatsAppu nebo e-mailu.
        Po domluvě společně upřesníme druh a množství dezertů, termín a místo předání.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Levá karta: Kontakty pro objednání -->
      <div class="rounded-2xl bg-[#FAF7F2] border border-[#E8E2D8] p-6 flex flex-col justify-between gap-5">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#8B2635]/10 text-[#8B2635] text-xs font-semibold mb-4">
            Objednávejte min. {SITE.orderNoticeDays} pracovní dny předem
          </div>

          <dl class="space-y-3 text-sm sm:text-base">
            <div class="flex items-center justify-between gap-3 py-2 border-b border-[#E8E2D8]">
              <dt class="text-[#7A726C] font-medium">Telefon / WhatsApp</dt>
              <dd class="font-bold text-[#2C2725]">
                <a href={SITE.phoneHref} class="hover:text-[#8B2635] transition-colors">
                  {SITE.phoneDisplay}
                </a>
              </dd>
            </div>
            <div class="flex items-center justify-between gap-3 py-2 border-b border-[#E8E2D8]">
              <dt class="text-[#7A726C] font-medium">E-mail</dt>
              <dd class="font-bold text-[#2C2725]">
                <a href={`mailto:${SITE.email}`} class="hover:text-[#8B2635] transition-colors">
                  {SITE.email}
                </a>
              </dd>
            </div>
          </dl>
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl text-sm font-bold bg-[#25D366] text-white hover:bg-[#1EBE5D] transition-colors shadow-xs"
          >
            Objednat přes WhatsApp
          </a>
          <a
            href={SITE.phoneHref}
            class="flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl text-sm font-bold bg-[#8B2635] text-white hover:bg-[#721E2B] transition-colors shadow-xs"
          >
            Zavolat
          </a>
        </div>
      </div>

      <!-- Pravá karta: Převzetí -->
      <div class="rounded-2xl bg-[#FAF7F2] border border-[#E8E2D8] p-6">
        <h3 class="font-serif text-xl font-bold text-[#2C2725] mb-3">
          Převzetí ({SITE.location})
        </h3>
        <p class="text-sm sm:text-base text-[#5A534E] mb-4 leading-relaxed">
          Objednávku si můžete vyzvednout na <strong>Praze 7 v lokalitě {SITE.pickupPoint}</strong>:
        </p>
        <ul class="space-y-3 text-sm sm:text-base text-[#2C2725]">
          <li class="flex items-start gap-2.5">
            <span class="mt-1.5 w-2 h-2 rounded-full bg-[#C58B55] shrink-0" aria-hidden="true"></span>
            <span>Osobní odběr na adrese, kterou Vám sdělím při potvrzení objednávky.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-1.5 w-2 h-2 rounded-full bg-[#C58B55] shrink-0" aria-hidden="true"></span>
            <span>Předání u stanice metra <strong>Nádraží Holešovice</strong>, pokud Vám více vyhovuje vyzvednutí při cestě MHD.</span>
          </li>
        </ul>
        <p class="mt-4 pt-4 border-t border-[#E8E2D8] text-xs sm:text-sm text-[#7A726C]">
          Obě možnosti jsou po předchozí domluvě.
        </p>
      </div>
    </div>
  </div>
</section>
