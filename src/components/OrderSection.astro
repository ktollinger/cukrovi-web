---
import { SITE, getWhatsAppUrl } from '../data/site';

interface Props {
  prefill?: string;
}

const {
  prefill = 'Dobrý den, ráda bych si objednala u Rawtík (druh, velikost/množství a požadovaný termín): ',
} = Astro.props;

const whatsappLink = getWhatsAppUrl(prefill);
---

<section id="jak-objednat" class="scroll-mt-20 py-14 sm:py-16 bg-surface border-y border-line">
  <div class="max-w-5xl mx-auto px-4 space-y-8">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl sm:text-4xl font-bold text-ink">
        Jak objednat a převzetí
      </h2>
      <p class="mt-3 text-ink-soft leading-relaxed">
        Objednávky přijímám prostřednictvím WhatsAppu, telefonu nebo e-mailu, minimálně{' '}
        <strong class="text-ink">{SITE.orderNoticeDays} pracovní dny předem</strong>.
        Po domluvě společně upřesníme druh, množství, termín i místo předání.
      </p>
    </div>

    <!-- Tři stejně velké dlaždice kanálů (D6) -->
    <div class="reveal grid grid-cols-1 sm:grid-cols-3 gap-4">
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-[var(--radius-card)] bg-cream border border-line hover:border-ginger p-5 flex items-center gap-4 transition-colors"
      >
        <span class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-surface border border-line text-[#1FA855] shrink-0" aria-hidden="true">
          <svg class="w-5 h-5 fill-current" width="20" height="20" viewBox="4.5 4.5 15 15">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.297.144.35.491 1.199.534 1.286.043.087.072.188.014.303-.058.116-.087.188-.173.289l-.26.303c-.086.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564c.173.087.289.13.332.202.043.072.043.419-.101.824z" />
          </svg>
        </span>
        <div class="min-w-0">
          <p class="text-xs font-medium text-ink-muted">WhatsApp</p>
          <p class="font-semibold text-ink truncate">{SITE.phoneDisplay}</p>
        </div>
      </a>

      <a
        href={SITE.phoneHref}
        class="rounded-[var(--radius-card)] bg-cream border border-line hover:border-ginger p-5 flex items-center gap-4 transition-colors"
      >
        <span class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-surface border border-line text-brand shrink-0" aria-hidden="true">
          <svg class="w-5 h-5" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
        </span>
        <div class="min-w-0">
          <p class="text-xs font-medium text-ink-muted">Zavolat</p>
          <p class="font-semibold text-ink truncate">{SITE.phoneDisplay}</p>
        </div>
      </a>

      <a
        href={`mailto:${SITE.email}`}
        class="rounded-[var(--radius-card)] bg-cream border border-line hover:border-ginger p-5 flex items-center gap-4 transition-colors"
      >
        <span class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-surface border border-line text-brand shrink-0" aria-hidden="true">
          <svg class="w-5 h-5" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2" />
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
          </svg>
        </span>
        <div class="min-w-0">
          <p class="text-xs font-medium text-ink-muted">E-mail</p>
          <p class="font-semibold text-ink truncate">{SITE.email}</p>
        </div>
      </a>
    </div>

    <!-- Karta převzetí -->
    <div class="reveal rounded-[var(--radius-card)] bg-cream border border-line p-6 sm:p-7">
      <h3 class="font-display text-xl font-bold text-ink mb-2">
        Převzetí ({SITE.location})
      </h3>
      <p class="text-sm sm:text-base text-ink-soft mb-4">
        Objednávku si můžete vyzvednout na <strong class="text-ink">Praze 7 v lokalitě {SITE.pickupPoint}</strong> (obě možnosti po předchozí domluvě):
      </p>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm sm:text-base text-ink">
        <li class="flex items-start gap-2.5">
          <span class="mt-2 w-1.5 h-1.5 rounded-full bg-ginger shrink-0" aria-hidden="true"></span>
          <span>Osobní odběr na adrese, kterou Vám sdělím při potvrzení objednávky.</span>
        </li>
        <li class="flex items-start gap-2.5">
          <span class="mt-2 w-1.5 h-1.5 rounded-full bg-ginger shrink-0" aria-hidden="true"></span>
          <span>Předání u stanice metra <strong>Nádraží Holešovice</strong>, pokud Vám vyhovuje vyzvednutí při cestě MHD.</span>
        </li>
      </ul>
    </div>
  </div>
</section>
