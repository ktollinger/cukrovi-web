---
interface Props {
  aspect?: '4/3' | '1/1' | '4/5';
  class?: string;
  viewTransitionName?: string;
}

const { aspect = '4/3', class: className = '', viewTransitionName } = Astro.props;

const aspectClass =
  aspect === '1/1' ? 'aspect-square' : aspect === '4/5' ? 'aspect-[4/5]' : 'aspect-[4/3]';
---

<div
  class:list={[
    'bg-sand border border-line/80 flex items-center justify-center text-ink-muted',
    aspectClass,
    className,
  ]}
  style={viewTransitionName ? `view-transition-name: ${viewTransitionName}` : undefined}
  aria-hidden="true"
>
  <svg
    width="28"
    height="28"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="opacity-55"
  >
    <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z" />
    <circle cx="12" cy="13" r="3" />
  </svg>
</div>
